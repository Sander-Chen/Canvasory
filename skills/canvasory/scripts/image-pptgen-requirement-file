#!/usr/bin/env sh
# Prepare the confirmed Manual whole-Deck direction as the one Requirement file
# handed to `image-pptgen generate-and-follow --requirement-file`.
#
# This is the Skill's only preparation and verification path for that file.
# The direction text never appears in a shell argument: the Agent writes it with
# its file-edit tool and passes paths only.
#
#   /bin/sh "<skill_root>/scripts/image-pptgen-requirement-file" \
#     --source "<draft_path>" --output "<final_path>"
#
# The helper validates the draft, removes only the single structural trailing LF
# that a file-edit tool commonly adds, creates the final file atomically without
# overwriting an existing path, restricts it to owner-only permissions, reads it
# back byte-for-byte, and prints one bounded JSON receipt that contains no
# direction text.
#
# Exit codes: 0 = final file created and verified; 2 = helper usage error;
# 3 = the request was rejected and no final file was written.
#
# The file stays a POSIX `sh` launcher with an embedded, dependency-free Python
# program on purpose: current packaging copies Skill content without preserving
# the executable bit, and macOS Codex Desktop does not guarantee `python3` on
# PATH. The launcher therefore runs `/bin/sh` plus an interpreter resolved from
# the same per-user install roots the product itself uses.

set -eu

SCHEMA='image-pptgen-requirement-file/v1'

helper_error() {
  printf '{"schema":"%s","status":"error","error":"%s","message":"%s"}\n' \
    "$SCHEMA" "$1" "$2" >&2
  exit 3
}

# The product env override wins, then the Codex Desktop root, then the public
# per-user install root, then the Codex-managed runtime, then the system
# interpreter. A PATH lookup is the last resort for an explicitly configured
# host; it is never used to resolve the product CLI.
resolve_python() {
  home=${HOME:-}
  data_home=${XDG_DATA_HOME:-${home:+$home/.local/share}}
  if [ -n "${IMAGE_PPTGEN_INSTALL_ROOT:-}" ] \
    && [ -x "$IMAGE_PPTGEN_INSTALL_ROOT/current-venv/bin/python" ]; then
    printf '%s\n' "$IMAGE_PPTGEN_INSTALL_ROOT/current-venv/bin/python"
    return 0
  fi
  if [ -n "$home" ] && [ -x "$home/.codex/image-pptgen/current-venv/bin/python" ]; then
    printf '%s\n' "$home/.codex/image-pptgen/current-venv/bin/python"
    return 0
  fi
  if [ -n "$data_home" ] && [ -x "$data_home/image-pptgen/current-venv/bin/python" ]; then
    printf '%s\n' "$data_home/image-pptgen/current-venv/bin/python"
    return 0
  fi
  if [ -n "$home" ] && [ -x "$home/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3" ]; then
    printf '%s\n' "$home/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3"
    return 0
  fi
  if [ -x /usr/bin/python3 ]; then
    printf '%s\n' /usr/bin/python3
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    command -v python3
    return 0
  fi
  return 1
}

python=$(resolve_python) || helper_error "python_unavailable" "No Python 3 interpreter is available for the requirement helper."
"$python" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1 \
  || helper_error "python_unavailable" "The resolved Python interpreter is not Python 3.8 or newer."

"$python" - "$@" <<'PY'
import hashlib
import json
import os
import stat
import sys

SCHEMA = "image-pptgen-requirement-file/v1"
MAXIMUM_SOURCE_BYTES = 1024 * 1024
USAGE_EXIT = 2
REJECTED_EXIT = 3


def emit_error(code, message, status=REJECTED_EXIT):
    payload = {"schema": SCHEMA, "status": "error", "error": code, "message": message}
    sys.stderr.write(json.dumps(payload, ensure_ascii=False) + "\n")
    raise SystemExit(status)


def parse_arguments(argv):
    """Accept only one --source path and one --output path, never content."""

    source = None
    target = None
    index = 0
    while index < len(argv):
        flag = argv[index]
        if flag not in ("--source", "--output"):
            emit_error(
                "helper_usage",
                "helper accepts only --source <path> and --output <path>",
                USAGE_EXIT,
            )
        if index + 1 >= len(argv) or not argv[index + 1]:
            emit_error("helper_usage", flag + " requires a non-empty path", USAGE_EXIT)
        value = argv[index + 1]
        if flag == "--source":
            if source is not None:
                emit_error("helper_usage", "--source accepts one path", USAGE_EXIT)
            source = value
        else:
            if target is not None:
                emit_error("helper_usage", "--output accepts one path", USAGE_EXIT)
            target = value
        index += 2
    if source is None or target is None:
        emit_error(
            "helper_usage",
            "helper requires --source <path> and --output <path>",
            USAGE_EXIT,
        )
    return source, target


def is_within(workspace, candidate):
    if candidate == workspace:
        return True
    prefix = workspace if workspace.endswith(os.sep) else workspace + os.sep
    return candidate.startswith(prefix)


def main():
    source_argument, target_argument = parse_arguments(sys.argv[1:])

    # Both paths resolve against the current workspace, so a relative draft or
    # output name is accepted while every resolved path still has to stay
    # inside that workspace.
    workspace = os.path.realpath(os.getcwd())
    resolved_source = os.path.realpath(source_argument)
    resolved_target = os.path.realpath(target_argument)
    if not is_within(workspace, resolved_source):
        emit_error("path_outside_workspace", "--source must resolve inside the current workspace")
    if not is_within(workspace, resolved_target):
        emit_error("path_outside_workspace", "--output must resolve inside the current workspace")
    if resolved_source == resolved_target:
        emit_error("identical_paths", "--source and --output must be different paths")

    try:
        source_mode = os.lstat(resolved_source).st_mode
    except OSError:
        emit_error("source_missing", "--source does not exist")
    if stat.S_ISLNK(source_mode) or not stat.S_ISREG(source_mode):
        emit_error(
            "source_not_regular_file",
            "--source must be a regular file, not a link or directory",
        )

    try:
        os.lstat(resolved_target)
    except FileNotFoundError:
        pass
    except OSError:
        emit_error("output_unsafe", "--output cannot be inspected safely")
    else:
        emit_error("output_exists", "--output already exists; this helper never overwrites")

    if not os.path.isdir(os.path.dirname(resolved_target)):
        emit_error("output_parent_missing", "--output parent directory does not exist")

    try:
        source_size = os.path.getsize(resolved_source)
    except OSError:
        emit_error("source_unreadable", "--source cannot be read")
    if source_size == 0:
        emit_error("source_empty", "--source has no direction text")
    if source_size > MAXIMUM_SOURCE_BYTES:
        emit_error("source_too_large", "--source exceeds the requirement size policy")

    try:
        with open(resolved_source, "rb") as handle:
            payload = handle.read(MAXIMUM_SOURCE_BYTES + 1)
    except OSError:
        emit_error("source_unreadable", "--source cannot be read")
    if len(payload) > MAXIMUM_SOURCE_BYTES:
        emit_error("source_too_large", "--source exceeds the requirement size policy")
    if b"\x00" in payload:
        emit_error("source_contains_nul", "--source must not contain a NUL byte")
    if b"\r" in payload:
        emit_error(
            "source_contains_carriage_return",
            "--source must not use CR or CRLF line endings",
        )
    try:
        payload.decode("utf-8")
    except UnicodeDecodeError:
        emit_error("source_not_utf8", "--source must be valid UTF-8")

    # Remove only the single structural trailing LF a file-edit tool adds; every
    # other byte, including a source without any trailing LF, is preserved.
    trailing_lf_removed = payload.endswith(b"\n")
    final_payload = payload[:-1] if trailing_lf_removed else payload
    if not final_payload.decode("utf-8").strip():
        emit_error("source_empty", "--source has no direction text")

    create_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        create_flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(resolved_target, create_flags, 0o600)
    except FileExistsError:
        emit_error("output_exists", "--output already exists; this helper never overwrites")
    except OSError:
        emit_error("output_unwritable", "--output cannot be created safely")

    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(final_payload)
            handle.flush()
            os.fsync(handle.fileno())
            os.fchmod(handle.fileno(), 0o600)
            observed_mode = stat.S_IMODE(os.fstat(handle.fileno()).st_mode)
    except OSError:
        try:
            os.unlink(resolved_target)
        except OSError:
            pass
        emit_error("output_write_failed", "--output could not be written completely")

    read_flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        read_flags |= os.O_NOFOLLOW
    verified = None
    try:
        read_descriptor = os.open(resolved_target, read_flags)
        with os.fdopen(read_descriptor, "rb") as handle:
            verified = handle.read(MAXIMUM_SOURCE_BYTES + 1)
    except OSError:
        verified = None
    if verified != final_payload:
        try:
            os.unlink(resolved_target)
        except OSError:
            pass
        emit_error("output_verify_failed", "--output did not read back byte-for-byte")

    receipt = {
        "schema": SCHEMA,
        "status": "ok",
        "workspace": workspace,
        "source_path": resolved_source,
        "final_path": resolved_target,
        "source_bytes": len(payload),
        "final_bytes": len(final_payload),
        "trailing_lf_removed": trailing_lf_removed,
        "source_sha256": hashlib.sha256(payload).hexdigest(),
        "final_sha256": hashlib.sha256(final_payload).hexdigest(),
        "final_mode": format(observed_mode, "04o"),
    }
    sys.stdout.write(json.dumps(receipt, ensure_ascii=False, sort_keys=False) + "\n")
    return 0


raise SystemExit(main())
PY
